# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# ── Raspberry Pi SSH (used by ssh_deploy.py and the pi_*.py / verify_pi.py /
#    install_ollama_pi.py / upload_whisper_models.py helpers) ──────────────────
PI_HOST=raspberrypi.local
PI_USER=pi
PI_PASSWORD=change-me

# ── Runtime options read by orchestrator.py / text_to_speech*.py (all optional) ─
# RUYA_VIDEO_SOURCE=camera          # camera | video
# RUYA_TEST_VIDEO_PATH=testvideo.mp4
# RUYA_CAMERA_INDEX=0
# RUYA_CAMERA_URL=http://<esp32-cam-ip>:81/stream   # ESP32-CAM Wi-Fi MJPEG stream
# RUYA_SERIAL_PORT=/dev/ttyUSB0     # ESP32-CAM over USB-serial (Linux only)
# RUYA_SERIAL_BAUD=921600
# RUYA_VISION_INTERVAL=1.0
# RUYA_TTS_ENGINE=auto              # auto | piper | sapi (Windows) / espeak (Pi)
# RUYA_TTS_SPEED=1.3
# RUYA_PIPER_PATH=
# RUYA_PIPER_MODEL=tts_models/en_US-amy-medium.onnx
# RUYA_PIPER_CONFIG=
